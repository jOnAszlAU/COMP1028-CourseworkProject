#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <ctype.h>

#define MAX_WORD_LEN 50
#define MAX_UNIQUE_WORDS 5000
#define MAX_PATH_LEN 256
#define MAX_DOCS 20000
#define MAX_CORPUS_VOCAB 100000

const char *STOPWORDS[] = {
    "a", "about", "above", "after", "again", "against", "all", "am", "an", "and",
    "any", "are", "as", "at", "be", "because", "been", "before", "being", "below",
    "between", "both", "but", "by", "can", "could", "did", "do", "does", "doing",
    "down", "during", "each", "few", "for", "from", "further", "had", "has", "have",
    "having", "he", "her", "here", "hers", "herself", "him", "himself", "his", "how",
    "i", "if", "in", "into", "is", "it", "its", "itself", "just", "me", "more",
    "most", "my", "myself", "no", "nor", "not", "now", "of", "off", "on", "once",
    "only", "or", "other", "our", "ours", "ourselves", "out", "over", "own", "re",
    "same", "she", "should", "so", "some", "such", "than", "that", "the", "their",
    "theirs", "them", "themselves", "then", "there", "these", "they", "this", "those",
    "through", "to", "too", "under", "until", "up", "very", "was", "we", "were",
    "what", "when", "where", "which", "while", "who", "whom", "why", "will", "with",
    "would", "you", "your", "yours", "yourself", "yourselves"
};
const int NUM_STOPWORDS = sizeof(STOPWORDS) / sizeof(STOPWORDS[0]);

typedef struct {
    char word[MAX_WORD_LEN];
    int frequency; // Term frequency within this document
} TermEntry;

typedef struct {
    int doc_id;
    char filepath[MAX_PATH_LEN];
    int raw_terms;       // Total words before stopword removal
    int total_terms;     // Total searchable terms after stopword removal
    int unique_terms;    // Unique searchable terms in this document
    TermEntry *terms;
    int is_valid;
} Document;

// Comparator for bsearch on STOPWORDS
int compare_strings(const void *a, const void *b) {
    const char *key = (const char *)a;
    const char *elem = *(const char **)b;
    return strcmp(key, elem);
}

// filtering rules:
// minimum length of 2 characters
// not in stopwords list
int is_stopword_or_invalid(const char *word) {
    if (strlen(word) < 2) {
        return 1;
    }
    if (bsearch(word, STOPWORDS, NUM_STOPWORDS, sizeof(char *), compare_strings) != NULL) {
        return 1;
    }
    return 0;
}

// finds searchable term and then increments the count
void record_term(const char *word, TermEntry *temp_terms, int *unique_count, int *hit_limit, int doc_id, const char *filepath) {
    for (int i = 0; i < *unique_count; i++) {
        if (strcmp(temp_terms[i].word, word) == 0) {
            temp_terms[i].frequency++;
            return;
        }
    }

    if (*unique_count < MAX_UNIQUE_WORDS) {
        strcpy(temp_terms[*unique_count].word, word);
        temp_terms[*unique_count].frequency = 1;
        (*unique_count)++;
    } else if (!(*hit_limit)) {
        *hit_limit = 1;
        printf("[Doc ID: %d] Note: Reached MAX_UNIQUE_WORDS (%d) in '%s'\n",
               doc_id, MAX_UNIQUE_WORDS, filepath);
    }
}

Document process_document(int doc_id, const char *filepath) {
    Document doc;
    doc.doc_id = doc_id;
    strncpy(doc.filepath, filepath, MAX_PATH_LEN - 1);
    doc.filepath[MAX_PATH_LEN - 1] = '\0';
    doc.raw_terms = 0;
    doc.total_terms = 0;
    doc.unique_terms = 0;
    doc.terms = NULL;
    doc.is_valid = 0;

    FILE *file = fopen(filepath, "r");
    if (file == NULL) {
        printf("[Doc ID: %d] Warning: Could not open '%s' (skipping)\n", doc_id, filepath);
        return doc;
    }

    TermEntry *temp_terms = malloc(MAX_UNIQUE_WORDS * sizeof(TermEntry));
    if (temp_terms == NULL) {
        printf("[Doc ID: %d] Error: Memory allocation failed for '%s'\n", doc_id, filepath);
        fclose(file);
        return doc;
    }

    char word_buffer[MAX_WORD_LEN];
    int buffer_index = 0;
    int ch;
    int hit_limit = 0;

    while ((ch = fgetc(file)) != EOF) {
        ch = tolower((unsigned char)ch); // turn into lowercase

        if (isalpha((unsigned char)ch)) {
            if (buffer_index < MAX_WORD_LEN - 1) {
                word_buffer[buffer_index++] = (char)ch;
            }
        } else {
            if (buffer_index > 0) { // ignore empty tokens
                word_buffer[buffer_index] = '\0';
                doc.raw_terms++;

                if (!is_stopword_or_invalid(word_buffer)) {
                    doc.total_terms++;
                    record_term(word_buffer, temp_terms, &doc.unique_terms, &hit_limit, doc_id, filepath);
                }
                buffer_index = 0;
            }
        }
    }

    // Handle trailing word at endof file
    if (buffer_index > 0) {
        word_buffer[buffer_index] = '\0';
        doc.raw_terms++;

        if (!is_stopword_or_invalid(word_buffer)) {
            doc.total_terms++;
            record_term(word_buffer, temp_terms, &doc.unique_terms, &hit_limit, doc_id, filepath);
        }
    }

    fclose(file);

    if (doc.total_terms == 0) {
        printf("[Doc ID: %d] Warning: '%s' has no searchable terms (skipping)\n", doc_id, filepath);
        free(temp_terms);
        return doc;
    }

    // memory allocation... to not waste memory
    doc.terms = malloc(doc.unique_terms * sizeof(TermEntry));
    if (doc.terms != NULL) {
        memcpy(doc.terms, temp_terms, doc.unique_terms * sizeof(TermEntry));
    }
    free(temp_terms);

    doc.is_valid = 1;
    return doc;
}

int main(void) {
    FILE *list_file = fopen("filelist.txt", "r");
    if (list_file == NULL) {
        printf("Error: Could not open 'filelist.txt'. Please create it with your file paths.\n");
        return 1;
    }

    Document *docs = malloc(MAX_DOCS * sizeof(Document));
    if (docs == NULL) {
        printf("Error: Could not allocate memory for document collection.\n");
        fclose(list_file);
        return 1;
    }

    int doc_count = 0;
    int next_doc_id = 1;
    long total_raw_words = 0;
    long total_searchable_words = 0;

    char filepath[MAX_PATH_LEN];

    printf("Loading and tokenizing corpus...\n");

    while (fgets(filepath, sizeof(filepath), list_file) != NULL) {
        if (doc_count >= MAX_DOCS) {
            printf("Warning: Reached MAX_DOCS (%d). Stopping file loading.\n", MAX_DOCS);
            break;
        }

        filepath[strcspn(filepath, "\r\n")] = '\0';
        if (filepath[0] == '\0') {
            continue;
        }

        Document current_doc = process_document(next_doc_id, filepath);

        if (current_doc.is_valid == 1) {
            docs[doc_count] = current_doc;
            total_raw_words += docs[doc_count].raw_terms;
            total_searchable_words += docs[doc_count].total_terms;
            doc_count++;
            next_doc_id++;
        }
    }

    fclose(list_file);


    printf("Valid Documents Loaded:      %d\n", doc_count);
    printf("Total Words:             %ld\n", total_raw_words);
    printf("Total Searchable Terms:      %ld (after stopword & length filtering)\n", total_searchable_words);

    if (doc_count > 0) {
        printf("\nSample Doc [ID: %d] '%s' -> Total: %d | Unique: %d\n",
               docs[0].doc_id, docs[0].filepath, docs[0].total_terms, docs[0].unique_terms);
    }

    // free all allocated memory
    for (int i = 0; i < doc_count; i++) {
        free(docs[i].terms);
    }
    free(docs);

    return 0;
}
